# Copy to .env and fill in real values. .env is gitignored; this template is not.

# Regolith needs COM_MOJANG on non-Windows systems to resolve the development export target.
COM_MOJANG="/Users/fox/Library/Application Support/Minecraft Bedrock Launcher/MinecraftData/games/com.mojang"

# SFTP target used by `npm run push` to upload betafied_bp / betafied_rp to the hosted server.
BETAFIED_SFTP_HOST="your-server.example.com"
BETAFIED_SFTP_PORT="2022"
BETAFIED_SFTP_USER="your-sftp-user"
BETAFIED_SFTP_PASSWORD="your-sftp-password"
