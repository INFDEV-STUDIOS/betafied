[TEMPLATE]
# Copy to .env and fill in real values. .env is gitignored; this template is not.

# The Bedrock data directory Regolith exports the development packs into.
# Windows needs nothing here: Regolith resolves the UWP data folder itself.
# macOS falls back to the Bedrock Launcher location under your home directory.
# Linux installs can live anywhere, so set this explicitly.
COM_MOJANG="/path/to/com.mojang"

# Server deployment (SFTP) credentials no longer live in this repo. They belong to the
# private betafied-manager tool, which pushes the built packs to the hosted server. See
# betafied-manager/.env.example.
